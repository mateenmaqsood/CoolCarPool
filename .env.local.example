# CoolCarPool — environment variables
# Copy to .env.local and fill in real keys.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: NEVER expose to the client bundle
SUPABASE_SERVICE_ROLE_KEY=

# Slip OCR (claude-sonnet-4-6)
ANTHROPIC_API_KEY=

# Ride event emails (optional — in-app notifications work without it)
RESEND_API_KEY=

# Maps (optional — leave empty to keep the SVG route simulation)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
